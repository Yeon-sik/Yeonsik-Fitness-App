<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions for the wearable PR0 probe (K-01). The shared Health Connect permission
  explanation and exercise and heart rate permissions are defined in the main manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read-only. ExerciseSession and Steps are auxiliary PR0 observations, not the G-HR gate. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <queries>
        <!-- Health Connect availability check and installed-version lookup for the PR0 record. -->
        <package android:name="com.google.android.healthconnect.controller" />
        <package android:name="com.android.healthconnect.controller" />
        <package android:name="com.sec.android.app.shealth" />
    </queries>

    <application>
        <activity
            android:name=".probe.wearable.WearableProbeActivity"
            android:exported="true"
            android:label="@string/wearable_probe_label"
            android:taskAffinity="${applicationId}.wearableprobe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
